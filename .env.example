# CreatorOS Environment Configuration

# Target execution environment ('dev' or 'prod')
# In 'prod' mode, requests go through xKiro API gateway: https://api.xkiro.com/v1
NODE_ENV=dev
TARGET_ENVIRONMENT=dev

# Local Antigravity Gateway (dev mode)
ANTIGRAVITY_BASE_URL=http://127.0.0.1:8999/v1
ANTIGRAVITY_API_KEY=agw-local-WsQ3RTRvPQ77ezqeEXhjWzoHyi-zRIVJ1voAJut5VeI

# xKiro API Gateway (prod mode) - https://api.xkiro.com/v1
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_API_KEY=[REDACTED]

# Optional provider overrides
OPENAI_BASE_URL=https://api.xkiro.com/v1
OPENAI_API_KEY=[REDACTED]

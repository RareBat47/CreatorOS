{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "build",
      "command": "pnpm build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "type": "shell",
      "label": "test",
      "command": "pnpm test",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "dev",
      "command": "pnpm dev",
      "isBackground": true
    },
    {
      "type": "shell",
      "label": "opencode:run",
      "command": "./scripts/run-opencode.sh",
      "windows": {
        "command": ".\\scripts\\run-opencode.bat"
      }
    }
  ]
}

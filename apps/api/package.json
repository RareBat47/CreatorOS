{
  "name": "@creatoros/api",
  "version": "0.1.0",
  "type": "module",
  "description": "CreatorOS API Service built on Hono and Node.js",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",

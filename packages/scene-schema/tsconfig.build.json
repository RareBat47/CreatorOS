{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "src/index.ts",
    "src/types.ts",
    "src/scene.ts",
    "src/creator.ts",
    "src/repurposing.ts",
    "src/quality.ts"
  ]
}
